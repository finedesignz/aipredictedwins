FROM python:3.13-slim

WORKDIR /app

# Install Node.js (needed for Claude Code CLI)
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source and entrypoint
COPY src/ src/
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create data dir for SQLite (populated at runtime via persistent volume)
RUN mkdir -p /app/data

# Entrypoint handles credential injection from CLAUDE_CREDENTIALS env var
ENTRYPOINT ["/app/entrypoint.sh"]
