FROM python:3.13-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY src/ src/
# Create data dir for SQLite (populated at runtime via persistent volume)
RUN mkdir -p /app/data

# Run the Alpaca orchestrator in paper mode
CMD ["python", "-m", "src.alpaca_orchestrator", "--mode", "paper"]
